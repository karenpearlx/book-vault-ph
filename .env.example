# OGTool blog API key (server-side only — never ship in client bundles or commit real values)
OGTOOL_API_KEY=
# OGTool API base (optional; defaults to https://app.ogtool.com/api)
OGTOOL_API_URL=
# Reverse-proxy target for /blog (optional; server.mjs falls back to the origin
# hardcoded there, which must match the rewrite targets in vercel.json)
OGTOOL_BLOG_ORIGIN=
